# Copy to .env and replace the secret before running.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://institution:local-development-only@db:5432/institution
POSTGRES_PASSWORD=local-development-only
FRONTEND_ORIGINS=http://localhost:5173
# Console delivery is LOCAL ONLY; set SMTP backend and credentials in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=office@localhost
COOKIE_SAMESITE=Lax
TRUST_PROXY=false
# Compose broker hostname; native cloud scripts override this to 127.0.0.1.
REDIS_URL=redis://redis:6379/0
